{
  "manifest_version": 3,
  "name": "Cognito Reader",
  "version": "1.2.0",
  "description": "Applies local unblur, text selection and interaction changes on Cognito pages.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://cognito.org/*"],
      "css": ["reader.css"],
      "js": ["reader.js"],
      "run_at": "document_start"
    }
  ]
}
